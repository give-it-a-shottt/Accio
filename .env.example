# 로컬 개발용. 이 파일을 .env 로 복사해 값을 채운다. (.env 는 git 에 올라가지 않는다)
# 배포(Vercel)에는 서버가 쓰는 값(GEMINI_API_KEY · SUPABASE_URL · SUPABASE_PUBLISHABLE_KEY)만 넣는다.

# Gemini — Google AI Studio(aistudio.google.com)에서 발급
GEMINI_API_KEY=
# 상품 생성 · 질의 해석 모델. 비우면 gemini-3.5-flash-lite
GEMINI_MODEL=

# Supabase — 프로젝트 설정 > API Keys (새 키 sb_publishable_… / sb_secret_…)
# 예전 이름(SUPABASE_ANON_KEY · SUPABASE_SERVICE_ROLE_KEY)도 읽지만, 예전 키는 2026년 말 지원 종료 예정
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 상품 적재 스크립트 전용 (서버 · 배포에는 넣지 않는다)
SUPABASE_SECRET_KEY=

