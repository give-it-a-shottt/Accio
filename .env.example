# 로컬 개발용. 이 파일을 .env 로 복사해 값을 채운다. (.env 는 git 에 올라가지 않는다)
# 배포(Vercel)에는 서버가 쓰는 값(GEMINI_API_KEY · SUPABASE_URL · SUPABASE_ANON_KEY)만 넣는다.

# Gemini — Google AI Studio(aistudio.google.com)에서 발급
GEMINI_API_KEY=
# 상품 생성 · 질의 해석 모델. 비우면 gemini-3.6-flash
GEMINI_MODEL=

# Supabase — 프로젝트 설정 > API (anon 자리에 publishable 키, service_role 자리에 secret 키를 넣어도 된다)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 상품 적재 스크립트 전용 (서버 · 배포에는 넣지 않는다)
SUPABASE_SERVICE_ROLE_KEY=

# Pexels — 상품 사진 받기 스크립트 전용 (pexels.com/api 에서 무료 발급)
PEXELS_API_KEY=
