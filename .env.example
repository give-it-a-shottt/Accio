# 로컬 개발용. 이 파일을 .env 로 복사해 값을 채운다. (.env 는 git 에 올라가지 않는다)
# 배포(Vercel)에는 서버가 쓰는 값(GEMINI_API_KEY · SUPABASE_URL · SUPABASE_ANON_KEY)만 넣는다.

# Gemini — Google AI Studio 에서 발급
GEMINI_API_KEY=

# Supabase — 프로젝트 설정 > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 상품 적재 스크립트 전용 (서버 · 배포에는 넣지 않는다)
SUPABASE_SERVICE_ROLE_KEY=

# 네이버 검색 API — 수집 스크립트 전용 (서버 · 배포에는 넣지 않는다)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
